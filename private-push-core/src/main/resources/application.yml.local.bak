server:
  port: 8099

spring:
  application:
    name: private-push-core
  
  kafka:
    bootstrap-servers: localhost:9092
    consumer:
      group-id: private-push-service
      auto-offset-reset: latest
      enable-auto-commit: true
      key-deserializer: org.apache.kafka.common.serialization.StringDeserializer
      value-deserializer: org.apache.kafka.common.serialization.StringDeserializer
    producer:
      key-serializer: org.apache.kafka.common.serialization.StringSerializer
      value-serializer: org.apache.kafka.common.serialization.StringSerializer
  
  redis:
    host: localhost
    port: 6379
    database: 0
    timeout: 2000ms
    lettuce:
      pool:
        max-active: 50
        max-idle: 20
        min-idle: 5

# 私有推送配置
private:
  push:
    port: 8099

    jwt:
      secret: exchange-private-push-secret-key-must-be-at-least-256-bits-long-for-hs256
      expiration-minutes: 30
      refresh-minutes: 60

    connection:
      max-per-user: 5
      max-per-ip: 100
      heartbeat-interval: 30
      heartbeat-timeout: 60
      session-timeout-minutes: 30
    
    ack:
      enabled: true
      timeout-ms: 5000
      max-retry: 3
      retry-interval-ms: 1000
    
    rate-limit:
      messages-per-second: 100
      subscribe-per-second: 10
    
    kafka:
      order-state-topic: private-order-state
      account-change-topic: private-account-change
      position-change-topic: private-position-change
      consumer-group-id: private-push-service

# 监控
management:
  endpoints:
    web:
      exposure:
        include: health,info,metrics,prometheus
  metrics:
    export:
      prometheus:
        enabled: true
    tags:
      application: ${spring.application.name}

# 日志
logging:
  level:
    com.exchange.privatepush: INFO
    com.exchange.privatepush.handler: DEBUG
    com.exchange.privatepush.service: DEBUG
  pattern:
    console: "%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n"
