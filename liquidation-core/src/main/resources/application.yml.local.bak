server:
  port: 8088

spring:
  application:
    name: liquidation-core
  
  # 数据源配置
  datasource:
    driver-class-name: com.mysql.cj.jdbc.Driver
    url: jdbc:mysql://${DB_HOST:localhost}:${DB_PORT:3306}/${DB_NAME:exchange_liquidation}?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false
    username: ${DB_USERNAME:root}
    password: ${DB_PASSWORD:123456}  # 生产环境必须使用环境变量，不要使用默认值
    druid:
      initial-size: 5
      min-idle: 10
      max-active: 50  # 从20增加到50，支持更高并发
      max-wait: 60000
      validation-query: SELECT 1
      test-on-borrow: false
      test-while-idle: true
      time-between-eviction-runs-millis: 60000
  
  # MyBatis Plus配置
  mybatis-plus:
    mapper-locations: classpath*:/mapper/**/*.xml
    type-aliases-package: com.exchange.liquidation.entity
    configuration:
      map-underscore-to-camel-case: true
      log-impl: org.apache.ibatis.logging.stdout.StdOutImpl
    global-config:
      db-config:
        id-type: assign_id
        logic-delete-field: deleted
        logic-delete-value: 1
        logic-not-delete-value: 0
  
  # Redis配置
  data:
    redis:
      host: ${REDIS_HOST:localhost}
      port: ${REDIS_PORT:6379}
      password: ${REDIS_PASSWORD:}  # 生产环境必须设置密码
      database: ${REDIS_DB:0}
      timeout: 5000ms
      lettuce:
        pool:
          max-active: 50  # 从20增加到50
          max-idle: 20  # 从10增加到20
          min-idle: 10  # 从5增加到10
          max-wait: 5000ms
  
  # Kafka配置
  kafka:
    bootstrap-servers: ${KAFKA_SERVERS:localhost:9092}

    # 消费者配置
    consumer:
      group-id: liquidation-service-group
      auto-offset-reset: earliest
      enable-auto-commit: false  # 使用手动ACK，防止消息丢失
      key-deserializer: org.apache.kafka.common.serialization.StringDeserializer
      value-deserializer: org.apache.kafka.common.serialization.StringDeserializer
      properties:
        max.poll.records: 50  # 从500减少到50，防止处理超时
        max.poll.interval.ms: 300000  # 5分钟处理超时
        session.timeout.ms: 30000  # 30秒心跳超时

    # 生产者配置
    producer:
      acks: all  # 金融级别必须使用all，等待所有ISR副本确认
      retries: 3
      batch-size: 16384
      buffer-memory: 33554432
      key-serializer: org.apache.kafka.common.serialization.StringSerializer
      value-serializer: org.apache.kafka.common.serialization.StringSerializer
      compression-type: lz4  # 使用LZ4压缩，提升性能
      linger-ms: 5
      properties:
        # 至少2个副本同步才算成功
        min.insync.replicas: 2
    
    # 监听器配置
    listener:
      ack-mode: manual_immediate  # 🔥 手动立即确认

# Nacos配置
  cloud:
    nacos:
      discovery:
        server-addr: localhost:8848
        namespace: dev
        group: DEFAULT_GROUP
        metadata:
          version: 1.0.0
          description: liquidation-service

# 强平服务配置
liquidation:
  # 订单配置
  order:
    # 默认订单类型: MARKET/LIMIT
    default-type: MARKET
    # 价格保护: 标记价格与最新价格最大偏差(百分比，如5表示5%)
    price-protection-threshold: 5
    # 限价单滑点(百分比)
    limit-price-slippage: 1
    # 大仓位拆分阈值(BTC数量，8位小数)
    split-threshold: 10000000000
    # 单次最大拆分数量
    max-split-quantity: 5000000000
  
  # 执行配置
  execution:
    # 订单监控周期(ms)
    monitor-interval: 100
    # 订单超时时间(ms)
    order-timeout: 30000
    # 最大重试次数
    max-retry: 3
    # 重试间隔(ms): 指数退避 100ms, 200ms, 400ms
    retry-base-interval: 100
  
  # 幂等配置
  idempotency:
    # 去重窗口(分钟)
    window-minutes: 5
    # Redis key前缀
    redis-key-prefix: "liquidation:idempotency:"
  
  # 性能配置
  performance:
    # 消费线程数
    consumer-threads: 8
    # 处理队列容量
    queue-capacity: 10000
    # 批量处理大小
    batch-size: 100
  
  # 下游服务地址
  service:
    oms:
      url: http://oms-core:8081
      timeout: 5000
      retry: 2
    position:
      url: http://position-snapshot-core:8086
      timeout: 3000
    insurance-fund:
      url: http://adl-core:8090
      timeout: 3000
    clearing:
      url: http://ledger-core:8084
      timeout: 5000

# Kafka Topic配置
kafka:
  topic:
    # 消费: 强平触发事件
    liquidation-trigger: liquidation-trigger-topic
    # 消费: 订单状态变更
    order-status: order-state-BTCUSDT
    # 生产: 强平完成事件
    liquidation-completed: liquidation-completed-topic
    # 生产: ADL触发事件
    adl-trigger: adl-trigger-topic

# 🍀 P1: 监控与链路追踪配置
management:
  endpoints:
    web:
      exposure:
        include: health,info,metrics,prometheus
  endpoint:
    health:
      show-details: always
  metrics:
    export:
      prometheus:
        enabled: true
    tags:
      application: ${spring.application.name}
  tracing:
    sampling:
      probability: 1.0
  zipkin:
    tracing:
      endpoint: http://localhost:9411/api/v2/spans

# 日志配置
logging:
  level:
    com.exchange.liquidation: INFO
    com.exchange.liquidation.consumer: INFO
    com.exchange.liquidation.service: INFO
  pattern:
    console: "%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{50} - %msg%n"
  file:
    name: logs/liquidation-service.log
