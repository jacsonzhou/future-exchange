server:
  port: 8083

spring:
  application:
    name: match-engine-core
  
  # Kafka配置（🔥 交易所级双通道架构）
  kafka:
    bootstrap-servers: localhost:9092
    
    # Consumer配置（OMS → Match Engine）
    consumer:
      # 消费者组（每个Symbol一个独立的group）
      group-id: match-engine-${match.symbol}
      
      # 自动提交
      enable-auto-commit: true
      auto-commit-interval-ms: 1000
      
      # 从最早的消息开始消费（灾备恢复）
      auto-offset-reset: earliest
      
      # 🔥 性能优化：立即消费，不等待
      fetch-min-bytes: 1
      fetch-max-wait-ms: 0
      max-poll-records: 500
      
      # 序列化器（Phase 2.2: 双协议支持，使用 ByteArrayDeserializer）
      key-deserializer: org.apache.kafka.common.serialization.StringDeserializer
      value-deserializer: org.apache.kafka.common.serialization.ByteArrayDeserializer
      
      # 会话超时
      session-timeout-ms: 30000
      heartbeat-interval-ms: 3000
    
    # Producer配置（Match Engine → OMS/Ledger/etc）
    producer:
      # 🔥 性能优化配置
      acks: 1                          # 不需要all
      retries: 3
      linger-ms: 0                     # 不等待batch
      compression-type: none           # 不压缩
      batch-size: 16384
      buffer-memory: 33554432
      
      # 序列化器（Phase 2.2: 双协议支持，使用 ByteArraySerializer）
      key-serializer: org.apache.kafka.common.serialization.StringSerializer
      value-serializer: org.apache.kafka.common.serialization.ByteArraySerializer
      
      # 生产环境优化
      max-in-flight-requests-per-connection: 5
      request-timeout-ms: 30000
  
  # Nacos配置
  cloud:
    nacos:
      discovery:
        server-addr: 127.0.0.1:8848
        namespace: dev
        group: DEFAULT_GROUP
      config:
        server-addr: 127.0.0.1:8848
        namespace: dev
        group: DEFAULT_GROUP
        file-extension: yml

# 撮合引擎配置
match:
  # 交易对（每个实例只负责一个Symbol）
  symbol: BTCUSDT

  # RingBuffer配置
  ringbuffer:
    size: 65536  # 必须是2的幂

  # 性能配置
  performance:
    target-qps: 100000
    target-latency-us: 100

  # ============================================
  # Phase 1-3 生产级优化配置
  # ============================================

  # Phase 1: 内存优化（GC 压力降低 50-70%）
  optimization:
    # Phase 1.1: 嵌入式链表（已强制启用，无需配置）
    intrusive-list-enabled: true

    # Phase 1.2: Order 对象池
    order-pool-enabled: true
    order-pool-size: 10000  # 建议 10000-50000

    # Phase 1.3: PriceLevel 对象池（注意：因 priceScaled 为 final，效果有限）
    price-level-pool-enabled: false
    price-level-pool-size: 1000

  # Phase 2: 序列化优化（延迟降低 10-50倍）
  serialization:
    protocol: json  # json / protobuf
    # 注意：切换到 protobuf 需要同步更新下游服务
  
  # Kafka Topic 配置（修复：支持配置化）
  kafka:
    topic:
      # 成交事件 Topic（与 market-price-core 保持一致）
      trade-event: trade-event

  # Phase 3: WAL 异步优化（延迟峰值降低 90%）
  wal:
    async-enabled: false  # 生产环境谨慎开启（断电风险）
    batch-size: 1000      # 批量大小
    flush-interval-ms: 10 # 刷盘间隔（毫秒）
    # 风险：断电可能丢失最后 10ms 的数据
    # 建议：配合 UPS 电源 + 监控告警

# 🍀 P1: 监控与链路追踪配置
management:
  endpoints:
    web:
      exposure:
        include: health,info,metrics,prometheus
  endpoint:
    health:
      show-details: always
  metrics:
    export:
      prometheus:
        enabled: true
    tags:
      application: ${spring.application.name}
  tracing:
    sampling:
      probability: 1.0
  zipkin:
    tracing:
      endpoint: http://localhost:9411/api/v2/spans

# Logging配置
logging:
  level:
    com.exchange.match: INFO
    com.exchange.match.processor: DEBUG
    com.exchange.match.consumer: INFO
    com.exchange.match.publisher: INFO
  pattern:
    console: "%d{yyyy-MM-dd HH:mm:ss.SSS} [%X{traceId}] [%X{spanId}] [%thread] %-5level %logger{50} - %msg%n"
